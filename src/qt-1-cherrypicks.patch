+    result.resize(len * 2);
+    uchar *rdata = (uchar *) result.data();
+    const QChar *ucp = uc;
+
+    //qDebug("QFontGb2312Codec::fromUnicode(const QString& uc, int& lenInOut = %d)", lenInOut);
+    uchar buf[8];
+    for (int i = 0; i < len; i++) {
