-
-#define        IsEucChar(c)        (((c) >= 0xa1) && ((c) <= 0xfe))
-#define        IsCP949Char(c)      (((c) >= 0x81) && ((c) <= 0xa0))
-#define        QValidChar(u)        ((u) ? QChar((ushort)(u)) : QChar(QChar::ReplacementCharacter))
-
