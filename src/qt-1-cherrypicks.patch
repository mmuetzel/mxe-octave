-static int qt_Big5hkscsToUnicode(const uchar *s, uint *pwc)
-{
-    uchar c1 = s[0];
-    if ((c1 >= 0x81 && c1 <= 0xfe)) {
-        uchar c2 = s[1];
-        if ((c2 >= 0x40 && c2 < 0x7f) || (c2 >= 0xa1 && c2 < 0xff)) {
-            uint i = 157 * (c1 - 0x81) + (c2 - (c2 >= 0xa1 ? 0x62 : 0x40));
-            ushort wc = 0xfffd;
-            if (i < 19782)
-                wc = big5hkscs_to_ucs[i];
-            if (wc != 0xfffd) {
-                *pwc = (uint) wc;
-                return 2;
-            }
-        }
-        return 0;
-    } else if (c1 < 0x80) {
-        *pwc = (uint) c1;
-        return 1;
-    }
-    return 0;
-}
