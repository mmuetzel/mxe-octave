-QByteArray QFontKsc5601Codec::convertFromUnicode(const QChar *uc, int len,  ConverterState *) const
-{
-    QByteArray result;
-    result.resize(len * 2);
-    uchar *rdata = (uchar *) result.data();
-    const QChar *ucp = uc;
-
-    for (int i = 0; i < len; i++) {
-        QChar ch(*ucp++);
-        ch = qt_UnicodeToKsc5601(ch.unicode());
-
-        if (! ch.isNull()) {
-            *rdata++ = ch.row() & 0x7f ;
-            *rdata++ = ch.cell() & 0x7f;
-        } else {
-            //white square
-            *rdata++ = 0x21;
-            *rdata++ = 0x60;
-        }
-    }
-
-    return result;
-}
