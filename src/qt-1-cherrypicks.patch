-#define        IsSjisChar1(c)        ((((c) >= 0x81) && ((c) <= 0x9f)) ||        \
-                         (((c) >= 0xe0) && ((c) <= 0xfc)))
-#define        IsSjisUDC1(c)        (((c) >= 0xf0) && ((c) <= 0xfc))
-#define        IsSjisChar2(c)        (((c) >= 0x40) && ((c) != 0x7f) && ((c) <= 0xfc))
