+#	ssh -p 443 freddy77@shell-ssh.sourceforge.net "cd $GROUPDIR && cat - > $1 && chmod 0664 $1" < $2
+}
+
+save_coverage()
+{
+	find include/ src/ -name \*.da -o -name \*.gc\* | tar zcf -  -T - > covsave.tgz
+}
+
+restore_coverage()
+{
+	find include/ src/ -name \*.da -o -name \*.gc\* -exec rm {} \;
+	tar zxf covsave.tgz
+	rm -f covsave.tgz
+}
+
+handle_exit()
+{
+	echo Exiting...
+	cd $HOME/cpp/freetds
+	rm -f freetds
+	ln -s "$FTDSDIR" freetds
+	rm -rf $WORKDIR
+}
+
