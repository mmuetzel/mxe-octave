new file mode 100644
index 0000000..3dc46fb
--- /dev/null
+++ b/src/tds/bulk.c
@@ -0,0 +1,289 @@
+/* FreeTDS - Library of routines accessing Sybase and Microsoft databases
+ * Copyright (C) 2008  Frediano Ziglio
