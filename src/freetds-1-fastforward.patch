+							<entry>TDS Version</entry>
+							<entry>Comment</entry>
+							</row>
+						</thead>
+					<tbody>
+						<row>
+							<entry>Sybase before System 10, Microsoft SQL Server 6.x</entry>
+							<entry>4.2</entry>
+							<entry>Still works with all products, subject to its limitations.  </entry>
+							</row>
+						<row>
+							<entry>Sybase System 10 and above</entry>
