+trap handle_exit EXIT
+cp -rp $FTDSDIR $WORKDIR
+rm -f freetds
+ln -s $WORKDIR freetds
+cd $WORKDIR
+find . \( -name \*.bb -o -name \*.bbg -o -name \*.da -o -name \*.gc\* \) -exec rm -f {} \;
+rm -rf autom4te.cache doc/doc covtmp coverage DBD-*
