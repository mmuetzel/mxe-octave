+		FTDSDIR=freetds64
+		FLAGS_ADD="$FLAGS_ADD_OLD"
+		WORKDIR=ftds_comp_old
+		;;
+	*)
+		echo 'Option not supported!' 1>&2
+		exit 1
+		;;
+	esac
