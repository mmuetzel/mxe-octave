index 0000000..8823cd9
--- /dev/null
+++ a/src/pool/stream.c
@@ -0,0 +1,455 @@
+/* TDSPool - Connection pooling for TDS based databases
+ * Copyright (C) 2001, 2002, 2003, 2004, 2005  Brian Bruns
