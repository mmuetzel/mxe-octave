+										</row>
+									<row>
+										<entry>Sybase <productname>SQL Anywhere</productname></entry>
+										<entry>7</entry>
+										<entry>2638</entry>
+										</row>
+									<row>
+										<entry>Microsoft <productname>SQL Server</productname></entry>
+										<entry>all</entry>
+										<entry>1433</entry>
+										</row>
+									</tbody>
