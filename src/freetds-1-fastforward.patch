 int
 main(int argc, char **argv)
 {
+	if (read_login_info())
+		exit(1);
+
+	/*
+	 * prepare our odbcinst.ini
+	 * is better to do it before connect cause uniODBC cache INIs
+	 * the name must be odbcinst.ini cause unixODBC accept only this name
+	 */
+	if (DRIVER[0]) {
+		FILE *f = fopen("odbcinst.ini", "w");
