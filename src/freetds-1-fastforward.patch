+							</row>
+						
+						<row>
+							<entry>dump file</entry>
+							<entry>any valid file name</entry>
+							<entry>none
+								Overridden by <link  linkend="TDSDUMP">TDSDUMP</link>.
+								</entry>
+							<entry>Specifies the location of a tds dump file and turns on logging</entry>
+							</row>
+						<row>
