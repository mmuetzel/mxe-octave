+<screen><prompt>$ </prompt><userinput>nm /usr/lib/libc.a | grep -w T | grep -E 'asprintf|basename'
+</userinput>
+<computeroutput>0000000000000000 T _basename
+0000000000000000 T _asprintf</computeroutput>
+</screen>
 			</para>
