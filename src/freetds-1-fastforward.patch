+	tPWD=`grep '^PWD=' < PWD | sed 's,^....,,'`
+	tSRV=`grep '^SRV=' < PWD | sed 's,^....,,'`
+	tDB=`grep '^DB=' < PWD | sed 's,^...,,'`
+}
+
+rm ~/freetds.log /tmp/sql.log
+
+for param
