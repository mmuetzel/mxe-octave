diff --git a/src/tds/sspi.c b/src/tds/sspi.c
new file mode 100644
index 0000000..86c3735
--- /dev/null
+++ b/src/tds/sspi.c
@@ -0,0 +1,240 @@
+/* FreeTDS - Library of routines accessing Sybase and Microsoft databases
+ * Copyright (C) 2010  Frediano Ziglio
