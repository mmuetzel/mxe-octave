 		Disconnect();
-		return 1;
+		exit(1);
 	}
 
 	ResetStatement();
 
 	Command("SELECT name FROM sysobjects WHERE 0=1");
+}
+
+int
+main(int argc, char **argv)
+{
+	use_odbc_version3 = 1;
+	Connect();
+
+	Test(0);
+	Test(1);
 
 	Disconnect();
 	return 0;

