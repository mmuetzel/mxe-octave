+
+CLEAN :
+	-\@erase "\$(INTDIR)\*.obj"
+	-\@erase "\$(OUTDIR)\*.exe"
+
+"\$(OUTDIR)" :
+	if not exist "\$(OUTDIR)/\$(NULL)" mkdir "\$(OUTDIR)"
+
+CPP=cl.exe
+CPP_PROJ=/nologo /MD /W3 /O2 /Ob2 /I "./" /D WIN32 /D NDEBUG /D _CONSOLE /D _MBCS /D FREETDS_SRCDIR=\\"..\\" /D DBNTWIN32 /Fo"\$(INTDIR)\\\\" /Fd"\$(INTDIR)\\\\" /FD /c 
+
+.c{\$(INTDIR)}.obj::
+	\$(CPP) \$(CPP_PROJ) \$<
+
