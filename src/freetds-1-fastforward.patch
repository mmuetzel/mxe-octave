+	/* NTLMv2 response */
+	/* Size of lm_v2_response is 16 + names_blob_len */
+	*ntlm_v2_response = make_lm_v2_response(ntlm_v2_hash, names_blob, names_blob_len, challenge);
+	if (!*ntlm_v2_response)
+		return TDS_FAIL;
