+++ lapack-3.12.1/CMakeLists.txt	2025-01-21 19:02:36.211454829 +0100
@@ -466,7 +466,7 @@
 # --------------------------------------------------
 
 if(NOT BLAS_FOUND)
-  set(ALL_TARGETS ${ALL_TARGETS} ${BLASLIB})
+  set(ALL_TARGETS ${ALL_TARGETS} ${BLASLIB} xerbla)
 endif()
 
 if(NOT LATESTLAPACK_FOUND)
