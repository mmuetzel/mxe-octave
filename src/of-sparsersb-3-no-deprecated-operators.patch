 %! tmr_unlink = onCleanup(@() unlink(sparsersb_temporary_render_file));
 %!test
-%! assert( 0==nnz(sparsersb(3,3) .- sparse(3,3)) )
-%!test
-%! assert( 0==nnz(sparsersb([],[],[],3,3    ) .- sparse([],[],[],3,3    )) )
-%!test
-%! assert( 0==nnz(sparsersb([],[],[],3,3,123) .- sparse([],[],[],3,3,321)) )
+%! assert( 0==nnz(sparsersb(3,3) - sparse(3,3)) )
+%!test
+%! assert( 0==nnz(sparsersb([],[],[],3,3    ) - sparse([],[],[],3,3    )) )
+%!test
+%! assert( 0==nnz(sparsersb([],[],[],3,3,123) - sparse([],[],[],3,3,321)) )
 %!test
