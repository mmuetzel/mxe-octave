From 1adc57db68b6ccdd20a1047a0d03d034c854cb2f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Markus=20M=C3=BCtzel?= <markus.muetzel@gmx.de>
Date: Mon, 19 May 2025 10:07:13 +0200
Subject: [PATCH] Drop adding double-quotes around mkoctfile function
 arguments.

---
 src/build_system.cpp  | 2 +-
 src/coder_runtime.cpp | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/build_system.cpp b/src/build_system.cpp
index 6fa25eb..66e5a55 100644
--- a/src/build_system.cpp
+++ b/src/build_system.cpp
@@ -504,7 +504,7 @@ namespace coder_compiler
         if(c == '\\')
           c = '/';
 
-      return "\"" + result + "\"";
+      return result;
     };
 
     auto call_mkoctfile = [] (const octave_value_list& args)
diff --git a/src/coder_runtime.cpp b/src/coder_runtime.cpp
index 3325865..529a253 100644
--- a/src/coder_runtime.cpp
+++ b/src/coder_runtime.cpp
@@ -1745,7 +1745,7 @@ template <int size>
       const octave_value_list& args, int nargout) -> octave_value_list  \
       { fcn_body };                                                     \
     octave_dld_function *fcn                                            \
-      = octave_dld_function::create ( F ## name, shl, #name, doc);      \
+      = octave_dld_function::create ( F ## name, shl, #name, #doc);     \
     if (relative)                                                       \
       fcn->mark_relative ();                                            \
     return fcn;                                                         \
-- 
2.47.1.windows.2

